{
  "expo": {
    "name": "Storm Isles",
    "slug": "storm-isles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/preview/app_icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stormisles.game"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/art/preview/adaptive_fg.png",
        "backgroundColor": "#3b1f6e"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stormisles.game",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0c2440",
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/art/preview/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0c2440"
        }
      ]
    ]
  }
}
